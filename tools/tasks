def cmd_reorder(args):
    """Move a task up or down in execution order. Usage: tasks reorder <project> <task_id> up|down"""
    if len(args) < 3:
        print("Usage: tasks reorder <project> <task_id> up|down")
        sys.exit(1)

    project, task_id, direction = args[0], args[1], args[2].lower()

    if direction not in ("up", "down"):
        print(f"Error: direction must be \'up\' or \'down\', got {direction!r}.")
        sys.exit(1)

    db = get_db()

    task = db.execute(
        "SELECT task_id, position, status FROM tasks WHERE project = ? AND task_id = ?",
        (project, task_id),
    ).fetchone()

    if not task:
        print(f"Error: Task {task_id} not found in project \'{project}\'.")
        db.close()
        sys.exit(1)

    current_pos = task["position"]
    status = task["status"]

    # Reorder stays within the same-status group so moving an open task
    # skips over done tasks and vice-versa.
    peers = db.execute(
        "SELECT task_id, position FROM tasks "
        "WHERE project = ? AND status = ? "
        "ORDER BY position NULLS LAST, task_id",
        (project, status),
    ).fetchall()

    peer_ids = [r["task_id"] for r in peers]
    try:
        idx = peer_ids.index(task_id)
    except ValueError:
        print(f"Error: Task {task_id} not found among {status!r} peers (status may have changed).")
        db.close()
        sys.exit(1)

    if direction == "up":
        if idx == 0:
            print(f"[{project}] Task {task_id} is already first.")
            db.close()
            return
        swap_idx = idx - 1
    else:
        if idx == len(peers) - 1:
            print(f"[{project}] Task {task_id} is already last.")
            db.close()
            return
        swap_idx = idx + 1

    swap_id = peer_ids[swap_idx]
    swap_pos = peers[swap_idx]["position"]

    # If either task lacks a position, normalize all peers before swapping.
    if current_pos is None or swap_pos is None:
        for i, r in enumerate(peers, start=1):
            db.execute(
                "UPDATE tasks SET position = ? WHERE project = ? AND task_id = ?",
                (i, project, r["task_id"]),
            )
        db.commit()
        current_pos = idx + 1
        swap_pos = swap_idx + 1

    db.execute(
        "UPDATE tasks SET position = ?, updated_at = datetime('now') WHERE project = ? AND task_id = ?",
        (swap_pos, project, task_id),
    )
    db.execute(
        "UPDATE tasks SET position = ?, updated_at = datetime('now') WHERE project = ? AND task_id = ?",
        (current_pos, project, swap_id),
    )
    db.commit()
    arrow = "\u2191" if direction == "up" else "\u2193"
    print(f"[{project}] Task {task_id} moved {direction} {arrow}")
    db.close()


def cmd_move(args):
    """Move a task to an absolute position. Usage: tasks move <project> <task_id> <position>"""
    if len(args) < 3:
        print("Usage: tasks move <project> <task_id> <position>")
        sys.exit(1)

    project, task_id = args[0], args[1]
    try:
        target = int(args[2])
    except ValueError:
        print(f"Error: position must be an integer, got {args[2]!r}.")
        sys.exit(1)

    db = get_db()

    task = db.execute(
        "SELECT task_id, status FROM tasks WHERE project = ? AND task_id = ?",
        (project, task_id),
    ).fetchone()

    if not task:
        print(f"Error: Task {task_id} not found in project '{project}'.")
        db.close()
        sys.exit(1)

    status = task["status"]

    peers = db.execute(
        "SELECT task_id FROM tasks "
        "WHERE project = ? AND status = ? "
        "ORDER BY position NULLS LAST, task_id",
        (project, status),
    ).fetchall()

    peer_ids = [r["task_id"] for r in peers]
    try:
        current_idx = peer_ids.index(task_id)
    except ValueError:
        print(f"Error: Task {task_id} not found among {status!r} peers.")
        db.close()
        sys.exit(1)

    # Clamp to valid range (1-based → 0-based index)
    target_idx = max(0, min(target - 1, len(peer_ids) - 1))

    # Reorder the list in Python, then renumber sequentially
    peer_ids.pop(current_idx)
    peer_ids.insert(target_idx, task_id)

    for i, tid in enumerate(peer_ids, start=1):
        db.execute(
            "UPDATE tasks SET position = ?, updated_at = datetime('now') "
            "WHERE project = ? AND task_id = ?",
            (i, project, tid),
        )
    db.commit()
    print(f"[{project}] Task {task_id} moved to position {target_idx + 1}")
    db.close()


COMMANDS = {
    "add": cmd_add,
    "done": cmd_done,
    "undone": cmd_undone,
    "list": cmd_list,
    "delete": cmd_delete,
    "clear": cmd_clear,
    "context": cmd_context,
    "pending": cmd_pending,
    "edit": cmd_edit,
    "reset": cmd_reset,
    "reorder": cmd_reorder,
    "move": cmd_move,
}


def print_help():
    print("tasks \u2014 Task list manager for Claude Code workflow automation\n")
    print("Commands:")
    print("  add <project> [id] <desc>    Add task (auto-numbers if no id)")
    print("  done <project> <task_id>     Mark task as done")
    print("  undone <project> <task_id>   Reopen a task")
    print("  list <project>               Show all tasks")
    print("  context <project>            Output task list + instructions for Claude")
    print("  edit <project> <id> <desc>   Edit task description")
    print("  delete <project> <task_id>   Delete a task")
    print("  clear <project>              Remove all done tasks")
    print("  pending <project>            Count of open tasks")
    print("  reset <project>              Reset all tasks to open")
    print("  reorder <project> <id> up|down    Move task up or down in execution order")
    print("  move <project> <id> <position>    Move task to absolute position (1 = first)")
    print()
    print("Task IDs: use numbers (1, 2, 3) for main tasks,")
    print("          number.letter (1.a, 1.b) for subtasks.")
    print()
    print("Integration with BTerminal auto-trigger:")
    print("  When auto-trigger is ON in BTerminal, completed tasks")
    print("  automatically advance to the next open task.")


if __name__ == "__main__":
    init_db()

    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print_help()
        sys.exit(0)

    cmd = sys.argv[1]
    if cmd not in COMMANDS:
        print(f"Unknown command: {cmd}")
        print_help()
        sys.exit(1)

    COMMANDS[cmd](sys.argv[2:])
