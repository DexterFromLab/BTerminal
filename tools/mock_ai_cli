#!/usr/bin/env python3
"""Mock AI CLI — provider-agnostic scripted state machine for E2E tests.

Replaces a real AI CLI binary (claude/copilot/aider) during testing.
Reads scenario JSON from MOCK_AI_CLI_SCENARIO env var or first CLI arg.
Loops on stdin: matches each line against scenario rules and writes
scripted response to stdout. Logs every event to MOCK_AI_CLI_LOG.

Scenario format:
  {
    "responses": [
      {"trigger": "<regex>", "reply": "<text>", "delay_ms": 100},
      ...
    ],
    "default_reply": "<text>",     // optional, when no rule matches
    "exit_on": "<regex>",          // optional, exit cleanly on match
    "emit_events_jsonl": {         // optional (T3.4) — Copilot tail-f
      "path": "...",               // target events.jsonl (~ expanded)
      "events": [
        {"delay_ms": 100, "event": {"type": "session.start", ...}},
        ...
      ]
    }
  }

When `emit_events_jsonl` is present, a background thread starts that
writes each scripted event to the target file after its `delay_ms`,
with line-buffered flush so a tail-f reader sees events in real time.
Mirrors the Copilot CLI behavior (events.jsonl produced incrementally)
so E2E tests can verify CopilotStatsReader / T4.1 idle detection.

Usage:
  MOCK_AI_CLI_SCENARIO=/path/to/scenario.json mock_ai_cli [args...]
  MOCK_AI_CLI_LOG=/tmp/mock.log mock_ai_cli /path/to/scenario.json

The mock ignores BTerminal-specific flags like --resume,
--dangerously-skip-permissions and any positional intro prompt arg
(prints it to log and continues).
"""

import json
import os
import re
import sys
import threading
import time

LOG_PATH = os.environ.get(
    "MOCK_AI_CLI_LOG",
    f"/tmp/mock_ai_cli_{os.getpid()}.log",
)


def _log(label, payload):
    try:
        with open(LOG_PATH, "a") as f:
            ts = time.time()
            text = payload if isinstance(payload, str) else repr(payload)
            f.write(f"[{ts:.3f}] {label}: {text}\n")
    except OSError:
        pass


def _load_scenario():
    """Locate scenario JSON: env var first, then argv[1] if file."""
    path = os.environ.get("MOCK_AI_CLI_SCENARIO")
    if not path and len(sys.argv) > 1 and os.path.isfile(sys.argv[1]):
        path = sys.argv[1]
    if not path:
        # Default: echo each input
        return {"default_reply": "ECHO: {input}"}
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        _log("scenario_error", str(exc))
        return {"default_reply": f"[mock_ai_cli error loading scenario: {exc}]"}


def _match_response(scenario, line):
    for rule in scenario.get("responses", []):
        try:
            if re.search(rule["trigger"], line):
                return rule
        except re.error:
            continue
    return None


def _start_events_emitter(scenario):
    """T3.4: spawn a background thread that writes scripted events to
    the target events.jsonl with per-event `delay_ms` pauses.

    Scenarios opt in by adding an `emit_events_jsonl` directive:
      {"emit_events_jsonl": {
          "path": "~/.copilot/session-state/<uuid>/events.jsonl",
          "events": [
              {"delay_ms": 100, "event": {"type": "session.start", ...}},
              ...
          ]}}

    Returns the started Thread instance (or None if the directive is
    absent / malformed). Daemon=True so the mock exits cleanly even
    if the emitter is mid-sleep.
    """
    spec = scenario.get("emit_events_jsonl")
    if not isinstance(spec, dict):
        return None
    path = os.path.expanduser(spec.get("path", "") or "")
    events = spec.get("events") or []
    if not path or not isinstance(events, list) or not events:
        return None

    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)

    def _emit():
        # Append-mode + line-buffered so a tail-f reader sees each
        # event as it's written. Truncation is the caller's concern
        # (test fixtures should ensure a clean dir before launch).
        try:
            with open(path, "a", buffering=1, encoding="utf-8") as fh:
                for entry in events:
                    if not isinstance(entry, dict):
                        continue
                    delay = entry.get("delay_ms", 0) / 1000.0
                    event = entry.get("event")
                    if delay > 0:
                        time.sleep(delay)
                    if event is None:
                        continue
                    line = json.dumps(event) + "\n"
                    fh.write(line)
                    fh.flush()
                    _log("emit_event", line.rstrip("\n")[:200])
        except OSError as exc:
            _log("emit_error", str(exc))

    thread = threading.Thread(
        target=_emit, daemon=True, name="mock-events-emitter",
    )
    thread.start()
    _log("emitter_started", f"path={path} count={len(events)}")
    return thread


def main():
    scenario = _load_scenario()
    _log("startup", f"argv={sys.argv} env_scenario={os.environ.get('MOCK_AI_CLI_SCENARIO')}")
    _log("scenario_loaded", json.dumps(scenario)[:500])

    # T3.4: kick off the events.jsonl emitter (if scenario opts in).
    # Runs in a daemon thread so the main stdin loop is not blocked.
    _start_events_emitter(scenario)

    # If first positional arg is intro prompt (not a file), log it.
    # BTerminal passes it as `claude --resume 'long prompt text...'`.
    for arg in sys.argv[1:]:
        if arg in ("--resume", "--dangerously-skip-permissions"):
            continue
        if os.path.isfile(arg):
            continue  # the scenario JSON path
        _log("intro_prompt_arg", arg)
        break

    # Print a startup message so user sees mock is alive
    print("MOCK_AI_CLI ready. Type messages, exit with Ctrl-D.", flush=True)

    exit_pattern = scenario.get("exit_on")
    default_reply = scenario.get("default_reply", "[no rule matched]")

    try:
        for line in sys.stdin:
            line = line.rstrip("\n")
            _log("stdin", line)
            if exit_pattern and re.search(exit_pattern, line):
                _log("exit_on_match", line)
                break
            rule = _match_response(scenario, line)
            if rule:
                delay = rule.get("delay_ms", 0) / 1000.0
                if delay:
                    time.sleep(delay)
                reply = rule["reply"].format(input=line)
                _log("reply", reply)
                print(reply, flush=True)
            else:
                reply = default_reply.format(input=line)
                _log("default_reply", reply)
                print(reply, flush=True)
    except KeyboardInterrupt:
        _log("interrupt", "")
    _log("shutdown", "")


if __name__ == "__main__":
    main()
